# Canonical site origin for SEO metadata and sitemap (no trailing slash)
# NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Optional: Plausible (public site domain in Plausible)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=flow-guide.example
# In development, Plausible does not load unless you set:
# NEXT_PUBLIC_PLAUSIBLE_ENABLE_DEV=true
# Optional self-hosted script URL (default: https://plausible.io/js/script.js)
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/script.js

# Optional: Sentry — no init when DSNs are unset (local / CI)
# Server (preferred) and edge:
# SENTRY_DSN=
# Client (browser errors):
# NEXT_PUBLIC_SENTRY_DSN=
